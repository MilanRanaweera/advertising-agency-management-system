FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json angular.json tsconfig.json ./
COPY application/frontend application/frontend
COPY user-management/frontend user-management/frontend
COPY service-package-management/frontend service-package-management/frontend
COPY quotation-management/frontend quotation-management/frontend
COPY project-management/frontend project-management/frontend
COPY payment-invoice-management/frontend payment-invoice-management/frontend
COPY communication-management/frontend communication-management/frontend
RUN npm ci --no-audit --no-fund && npm run build
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html
EXPOSE 80
